<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<dialog
    id="minhasReservasCalendarioModal"
    class="reserva-modal"
>

    <div class="reserva-modal-header">

        <div>
            <p class="eyebrow">Minhas reservas</p>

            <h2>
                Calendario de reservas
            </h2>
        </div>

        <button
            type="button"
            class="btn btn-secondary"
            id="fecharMinhasReservasCalendarioBtn"
        >
            Fechar
        </button>

    </div>


    <div class="reserva-calendar">

        <div class="reserva-calendar-header">

            <button
                type="button"
                class="btn btn-secondary"
                id="mesAnteriorMinhasReservasBtn"
            >
                &lt;
            </button>


            <h3 id="mesAnoMinhasReservasCalendario"></h3>


            <button
                type="button"
                class="btn btn-secondary"
                id="proximoMesMinhasReservasBtn"
            >
                &gt;
            </button>

        </div>


        <div class="reserva-calendar-weekdays">

            <span>Dom</span>
            <span>Seg</span>
            <span>Ter</span>
            <span>Qua</span>
            <span>Qui</span>
            <span>Sex</span>
            <span>Sab</span>

        </div>


        <div
            id="diasMinhasReservasCalendario"
            class="reserva-calendar-days"
        ></div>


        <div class="reserva-calendar-legend">

            <div class="reserva-calendar-legend-item">
                <span class="reserva-status-dot solicitada"></span>
                <span>Solicitada</span>
            </div>

            <div class="reserva-calendar-legend-item">
                <span class="reserva-status-dot aprovada"></span>
                <span>Aprovada</span>
            </div>

            <div class="reserva-calendar-legend-item">
                <span class="reserva-status-dot negada"></span>
                <span>Negada</span>
            </div>

            <div class="reserva-calendar-legend-item">
                <span class="reserva-status-dot cancelada"></span>
                <span>Cancelada</span>
            </div>

        </div>


        <div class="reserva-calendar-schedule">

            <h3 id="dataMinhasReservasTitulo">
                Selecione um dia
            </h3>

            <div id="minhasReservasDiaConteudo">

                <p>
                    Clique em um dia para visualizar
                    suas reservas.
                </p>

            </div>

        </div>

    </div>

</dialog>